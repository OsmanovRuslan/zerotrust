<?xml version="1.0" encoding="UTF-8"?>
<!--
    zerotrust-core — ядро модуля на чистой Java 21.

    Здесь нет ни одной зависимости от Spring: модель, математическая модель,
    движок решения, SPI, МАИ и TOTP должны собираться и тестироваться без контекста Spring.
    Из тестовых библиотек подключены только JUnit 5 и AssertJ — без spring-boot-starter-test,
    чтобы случайная зависимость от Spring не могла появиться незаметно.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ru.donstu.zerotrust</groupId>
        <artifactId>zerotrust-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>zerotrust-core</artifactId>
    <name>ZeroTrust Core</name>
    <description>Модель, математическая модель доверия, движок решения, SPI (без Spring)</description>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Покрытие ядра — не меньше 85% строк. Проверяется на фазе verify. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-core-coverage</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
